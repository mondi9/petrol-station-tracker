# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Maps API Key (Optional - for traffic-aware features)
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: Distance Matrix API
# Note: App works fine without this, using fallback calculations
VITE_GOOGLE_MAPS_API_KEY=

# Fuely Price API (per-station Lagos PMS prices, admin-triggered sync only)
# Sandbox key: free stable demo data, zero wallet charges.
# Generate at fuely.ng > API Access after creating an account.
# WARNING: production keys bill NGN 50 per successful response -
# keep the Fuely sync admin-triggered (Preview first, then Apply).
VITE_FUELY_API_KEY=

# Development
VITE_DEV_MODE=true

# Capgo OTA Updates
# Get your API key from the Capgo dashboard settings
CAPGO_TOKEN=your_api_key_here
# Must match capacitor.config.json appId
CAPGO_APP_ID=com.petrolstation.tracker
